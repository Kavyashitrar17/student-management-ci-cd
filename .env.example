# Copy this file to ".env" and replace the placeholders. NEVER commit ".env".

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Replace <username>, <password> and the cluster host. The database name
# ("student_management") is part of the path, before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/student_management?retryWrites=true&w=majority

# Local port. On Render this is set automatically - do not set PORT there.
PORT=3000

# "development" locally, "production" on Render.
NODE_ENV=development
